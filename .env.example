# =============================================================================
# tequoin-bot — environment variables
# Copy this file to `.env` and fill in your private keys.
# NEVER commit `.env` (it is in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Wallets (multi-wallet support)
# -----------------------------------------------------------------------------
# Comma-separated list of private keys. Each key may be with or without "0x".
# Pick which one(s) to use at runtime via the menu, or with --wallet <n|all>.
#
# Alternative: put one private key per line in `wallets.txt` (also gitignored).
# `wallets.txt` is loaded only if `PRIVATE_KEYS` is empty.
PRIVATE_KEYS=0xabc...,0xdef...

# -----------------------------------------------------------------------------
# RPC overrides (optional)
# -----------------------------------------------------------------------------
# Override default RPC endpoints. Leave commented to use the built-in defaults.
# TEQOIN_RPC_URL=https://rpc.teqoin.io
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# -----------------------------------------------------------------------------
# Explorer / indexer override (optional)
# -----------------------------------------------------------------------------
# Used by the transfer flow to fetch recipient addresses from recent on-chain
# activity. Leave commented to use the default.
# TEQOIN_API_URL=https://api.teqoin.io

# -----------------------------------------------------------------------------
# Transfer defaults (optional, can also be passed as CLI flags)
# -----------------------------------------------------------------------------
# Default amount in ETH (e.g. "0.001"). Empty = prompt at runtime.
# TRANSFER_AMOUNT=0.0001

# -----------------------------------------------------------------------------
# Main-account top-up threshold (optional)
# -----------------------------------------------------------------------------
# When the *main* wallet (PRIVATE_KEYS[0]) does a transfer with auto-recipient,
# any generated wallet whose balance is below this threshold is prioritized as
# a recipient before the bot samples random EOAs from the explorer pool.
# Default: 0.005 ETH. Set to "0" to disable top-up priority.
# MAIN_TOPUP_THRESHOLD=0.005

# -----------------------------------------------------------------------------
# Auto-24h overrides (optional)
# -----------------------------------------------------------------------------
# `pnpm start auto` uses these to randomize per-tx amounts. Defaults shown.
# Each amount is a positive decimal in ETH; min must be <= max.
# AUTO_TRANSFER_AMOUNT_MIN=0.0001
# AUTO_TRANSFER_AMOUNT_MAX=0.0013
# AUTO_BRIDGE_AMOUNT_MIN=0.0001
# AUTO_BRIDGE_AMOUNT_MAX=0.0013
#
# Cooldown duration between cycles, in hours. Defaults to 24. Use a small
# fractional value (e.g. 0.001 = 3.6s) when smoke-testing the loop.
# AUTO_COOLDOWN_HOURS=24

# -----------------------------------------------------------------------------
# Auto-adjust per-tx amounts to fit wallet balance (optional)
# -----------------------------------------------------------------------------
# When the bot uses a random per-tx amount range (auto-24h, or transfer/bridge
# with --random-min/--random-max), it auto-scales the range per wallet so
# `count × per_tx_max + count × gas_reserve` fits the wallet's balance. The
# values below set the per-tx fee headroom (decimal ETH) reserved on each
# source chain; the defaults are conservative for normal RPC conditions.
#
# TEQOIN_TRANSFER_GAS_RESERVE=0.000001
# SEPOLIA_TRANSFER_GAS_RESERVE=0.0001
# TEQOIN_BRIDGE_GAS_RESERVE=0.000002
# SEPOLIA_BRIDGE_GAS_RESERVE=0.0002

# -----------------------------------------------------------------------------
# Auto-24h pre-cycle worker top-up (optional)
# -----------------------------------------------------------------------------
# Before phase 1 of every auto cycle, when the main wallet is part of the
# active --wallet selection, the bot direct-transfers native ETH from main
# to every generated worker whose balance is below MAIN_TOPUP_THRESHOLD on
# TeQoin AND on Sepolia, bringing each up to AUTO_PRECYCLE_TOPUP_TARGET.
# Direct sends are used (not bridges) because withdraw bridges have a 24h
# challenge period and can't fund "right now" gas needs on Sepolia.
#
# Set AUTO_PRECYCLE_TOPUP=off to disable the phase entirely. Default "on".
# AUTO_PRECYCLE_TOPUP=on
#
# AUTO_PRECYCLE_TOPUP_TARGET defaults to 2 * MAIN_TOPUP_THRESHOLD (so workers
# get some headroom and don't immediately re-flag below threshold).
# AUTO_PRECYCLE_TOPUP_TARGET=0.01

# -----------------------------------------------------------------------------
# Auto-24h farm-main mode (optional)
# -----------------------------------------------------------------------------
# The TeQoin Mini App backend awards points per-Telegram-user and only the
# wallet currently registered with that Telegram account earns TePoints.
# Generated worker wallets never accrue real points because they aren't
# linked to any Telegram account.
#
# To make worker activity translate into points for your main wallet, the
# auto loop runs in "farm-main" mode by default:
#
#   - Every non-main wallet routes its TeQoin transfers to the main wallet
#     address (instead of random explorer addresses). Each landing tx
#     credits the main wallet with a "Receive" task on the mini app.
#   - The bridge phase runs only with the main wallet (workers don't earn
#     bridge points either).
#
# Set AUTO_FARM_MAIN=off to disable and fall back to the old behavior
# (workers send to explorer-derived addresses; all selected wallets bridge).
# Default "on".
# AUTO_FARM_MAIN=on

# =============================================================================
# tequoin-bot — environment variables
# Copy this file to `.env` and fill in your private keys.
# NEVER commit `.env` (it is in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Wallets (multi-wallet support)
# -----------------------------------------------------------------------------
# Comma-separated list of private keys. Each key may be with or without "0x".
# All wallets are loaded together; you choose which to use at runtime.
#
# Alternative: put one private key per line in `wallets.txt` (gitignored).
# `wallets.txt` is loaded if `PRIVATE_KEYS` is empty.
PRIVATE_KEYS=0xabc...,0xdef...

# -----------------------------------------------------------------------------
# Chain selection (optional)
# -----------------------------------------------------------------------------
# If set, skips the interactive chain picker.
# Allowed values: tequoin | sepolia
# CHAIN=tequoin

# -----------------------------------------------------------------------------
# RPC overrides (optional)
# -----------------------------------------------------------------------------
# Override default RPC endpoints. Leave commented to use the built-in defaults.
# TEQOIN_RPC_URL=https://rpc.teqoin.io
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# -----------------------------------------------------------------------------
# Transfer defaults (optional, can also be passed as CLI flags)
# -----------------------------------------------------------------------------
# Default recipient when running `transfer` without --to.
# TRANSFER_TO=0x0000000000000000000000000000000000000000
# Default amount in ETH (e.g. "0.001"). Empty = prompt at runtime.
# TRANSFER_AMOUNT=0.001
